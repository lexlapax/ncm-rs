+pub fn first_refinement_three_gemm(x: &Array, w: &Array, bias: &Array) -> Result<Array> {
+    let padded = ops::pad(x, &[(0, 0), (1, 1), (0, 0)], None, None)?;
+    let mut parts = Vec::with_capacity(3);
+    for k in 0..3 {
+        let source = padded.try_index((.., k..k + 128, ..))?;
+        let kernel = w.try_index((.., .., k))?.transpose_axes(&[1, 0])?;
+        parts.push(source.matmul(kernel)?);
+    }
+    Ok(parts[0].add(&parts[1])?.add(&parts[2])?.add(bias)?)
