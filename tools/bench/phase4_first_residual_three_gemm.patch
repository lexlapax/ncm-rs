+#[test]
+fn first_refinement_three_gemm_matches_convolution() {
+    let b = MlxBackend::gpu().unwrap();
+    let weights: Vec<f32> = (0..384 * 384 * 3)
+        .map(|i| ((i * 13 % 113) as f32 - 56.) / 4096.)
+        .collect();
+    let w = b.upload_f32(&weights, &[384, 384, 3]).unwrap();
+    let bias = b.upload_f32(&[0.01; 384], &[384]).unwrap();
+    for batch in [1, 16] {
+        let values: Vec<f32> = (0..batch * 128 * 384)
+            .map(|i| ((i * 73 % 1009) as f32 - 504.) / 4096.)
+            .collect();
+        let x = b.upload_f32(&values, &[batch, 128, 384]).unwrap();
+        let actual = b
+            .read_f32(&b.first_refinement_conv1d(&x, &w, &bias).unwrap())
+            .unwrap();
+        let expected = b
+            .read_f32(&b.conv1d(&x, &w, &bias, 1, 1, false).unwrap())
+            .unwrap();
+        assert_eq!(actual.len(), expected.len());
+        for (&a, &e) in actual.iter().zip(&expected) {
+            assert!((a - e).abs() <= 1e-5 + 1e-4 * e.abs(), "{a} vs {e}");
+        }
+    }
+}
