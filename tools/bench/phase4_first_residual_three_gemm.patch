+        bias: &MlxTensor,
+    ) -> Result<MlxTensor> {
+        if matches!(x.0.shape(), [batch, 128, 384] if *batch >= 16)
+            && weight.0.shape() == [384, 384, 3]
+            && bias.0.shape() == [384]
+        {
+            return self.array_op(&[x, weight, bias], || {
+                ops::first_refinement_three_gemm(&x.0, &weight.0, &bias.0)
+            });
+        }
+        self.conv1d(x, weight, bias, 1, 1, false)
+    }
