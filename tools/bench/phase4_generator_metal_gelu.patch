+//! Experimental exact-erf GELU for contiguous generator activations.
+use mlx_rs::{
+    Array, Dtype,
+    fast::{MetalKernel, MetalKernelApplyOptions, MetalKernelOptions, MetalKernelOutput},
+};
+
+const SOURCE: &str = r#"
+    uint i = thread_position_in_grid.x;
+    if (i >= count[0]) return;
+    float v = x[i];
+    output[i] = (v * 0.5f) * (1.0f + erf(v / 1.4142135623730951f));
+"#;
+
+#[allow(unsafe_code)]
+pub(crate) fn apply(x: &Array) -> crate::ops::Result<Array> {
+    if x.dtype() != Dtype::Float32 || x.shape().len() != 3 || x.shape().contains(&0) {
+        return Err("GELU requires a nonempty rank-three FP32 input".into());
+    }
+    let count = u32::try_from(x.size())?;
+    let count_array = Array::from_slice(&[count], &[1]);
+    let kernel = MetalKernel::new(
+        "ncm_generator_gelu",
+        &["x", "count"],
+        &["output"],
+        SOURCE,
+        MetalKernelOptions {
+            ensure_row_contiguous: true,
+            ..Default::default()
+        },
+    )?;
+    // SAFETY: MLX materializes row-contiguous inputs; the checked count bounds
+    // each read and output write, and each grid thread owns one element.
+    let mut output = unsafe {
+        kernel.apply(
+            &[x, &count_array],
+            &[MetalKernelOutput {
+                shape: x.shape().to_vec(),
+                dtype: Dtype::Float32,
+            }],
+            (count as usize, 1, 1),
+            (256, 1, 1),
+            MetalKernelApplyOptions::default(),
+        )?
+    };
+    if output.len() != 1 {
+        return Err("unexpected GELU output count".into());
+    }
+    Ok(output.remove(0))
+}
