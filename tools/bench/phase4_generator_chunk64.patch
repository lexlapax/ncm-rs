+    #[test]
+    fn chunked_generation_retains_level_major_random_words() {
+        let levels = [1, 8, 16, 24, 32, 40, 52, 64, 76, 92, 108, 128];
+        for batch in [1, 64, 65, 127, 128] {
+            let (initial, words) = generation_words(42, batch, &levels);
+            let mut reference = SplitMix64(42);
+            for word in initial {
+                assert_eq!(word, reference.next());
+            }
+            for (&length, actual) in levels[1..].iter().zip(&words) {
+                let expected: Vec<_> = (0..batch * length)
+                    .map(|_| (reference.next() >> 32) as u32)
+                    .collect();
+                let mut reassembled = Vec::new();
+                for start in (0..batch).step_by(64) {
+                    let end = (start + 64).min(batch);
+                    reassembled.extend_from_slice(&actual[start * length..end * length]);
+                }
+                assert_eq!(reassembled, expected);
+            }
+        }
+    }
