+// Generate original level-major random words before splitting rows.
+fn generation_words(seed: u64, batch: usize, levels: &[usize]) -> (Vec<u64>, Vec<Vec<u32>>) {
+    let mut random = SplitMix64(seed);
+    let initial = (0..batch).map(|_| random.next()).collect();
+    let levels = levels[1..]
+        .iter()
+        .map(|&length| {
+            (0..batch * length)
+                .map(|_| (random.next() >> 32) as u32)
+                .collect()
+        })
+        .collect();
+    (initial, levels)
+}
