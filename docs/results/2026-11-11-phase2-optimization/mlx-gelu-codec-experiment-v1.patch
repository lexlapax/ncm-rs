+
+#[test]
+fn compiled_gelu_matches_eager_for_supported_and_fallback_shapes() {
+    let backend = MlxBackend::gpu().unwrap();
+    for batch in [1_usize, 2, 3, 4] {
+        let mut values: Vec<f32> = (0..batch * 89 * 1024)
+            .map(|i| ((i * 73 % 1009) as f32 - 504.) / 80.)
+            .collect();
+        values[..5].copy_from_slice(&[0., -0., f32::INFINITY, f32::NEG_INFINITY, f32::NAN]);
+        let input = backend.upload_f32(&values, &[batch, 89, 1024]).unwrap();
+        let actual = backend.read_f32(&backend.gelu(&input).unwrap()).unwrap();
+        let clone = backend.clone();
+        let cloned = clone.read_f32(&clone.gelu(&input).unwrap()).unwrap();
+        assert!(
+            actual
+                .iter()
+                .zip(&cloned)
+                .all(|(a, b)| a.to_bits() == b.to_bits())
+        );
+        let expected = mlx_rs::with_device(mlx_rs::Device::gpu(), || {
+            let x = mlx_rs::Array::from_slice(&values, &[batch as i32, 89, 1024]);
+            let y = x.multiply(mlx_rs::Array::from_f32(0.5))?.multiply(
+                mlx_rs::ops::erf(x.divide(mlx_rs::Array::from_f32(std::f32::consts::SQRT_2))?)?
+                    .add(mlx_rs::Array::from_f32(1.))?,
+            )?;
+            y.eval()?;
+            Ok::<_, mlx_rs::error::Exception>(y.try_as_slice::<f32>()?.to_vec())
+        })
+        .unwrap();
+        assert_eq!(actual.len(), expected.len());
+        for (&a, &e) in actual.iter().zip(&expected) {
+            assert!(
+                (a.is_nan() && e.is_nan())
+                    || a.to_bits() == e.to_bits()
+                    || (a.is_finite() && e.is_finite() && (a - e).abs() <= 1e-5 + 1e-4 * e.abs()),
+                "batch={batch}: {a:?} vs {e:?}"
+            );
+        }
+    }
+}
