+        let x = b.upload_f32(&[1., 2., 3., 4.], &[2, 2]).unwrap();
+        let w = b.upload_f32(&[2., 1., -1., 3.], &[2, 2]).unwrap();
+        let bias = b.upload_f32(&[0.5, -0.5], &[2]).unwrap();
+        b.project_bias(&x, &w, &bias).unwrap()
+    };
+    assert_eq!(
+        output.flatten_all().unwrap().to_vec1::<f32>().unwrap(),
+        [4.5, 4.5, 10.5, 8.5]
+    );
+}
