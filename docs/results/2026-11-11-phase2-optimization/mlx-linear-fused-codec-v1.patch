+#[test]
+fn fused_interpolation_handles_views_and_special_values() -> Result<()> {
+    with_device(Device::gpu(), || {
+        let data: Vec<f32> = (0..2 * 5 * 7)
+            .map(|i| match i % 11 {
+                0 => f32::NAN,
+                1 => f32::INFINITY,
+                2 => f32::NEG_INFINITY,
+                3 => -0.0,
+                _ => (i as f32 - 30.) / 9.,
+            })
+            .collect();
+        let input = Array::from_slice(&data, &[2, 7, 5]);
+        let view = input.swap_axes(1, 2)?;
+        for length in [1_usize, 3, 8] {
+            let mut bins = Vec::new();
+            for i in 0..length {
+                let position = ((i as f64 + 0.5) * 5. / length as f64 - 0.5).max(0.);
+                let lo = (position.floor() as i32).min(4);
+                let hi = (lo + 1).min(4);
+                let weight = position - f64::from(lo);
+                let a = view
+                    .try_index((.., lo..lo + 1, ..))?
+                    .multiply(Array::from_f32((1. - weight) as f32))?;
+                let b = view
+                    .try_index((.., hi..hi + 1, ..))?
+                    .multiply(Array::from_f32(weight as f32))?;
+                bins.push(a.add(b)?);
+            }
+            let expected = mlx_rs::ops::concatenate(&bins, 1)?;
+            let actual = ops::linear1d(&view, length)?;
+            expected.eval()?;
+            actual.eval()?;
+            for (&a, &b) in expected
+                .try_as_slice::<f32>()?
+                .iter()
+                .zip(actual.try_as_slice::<f32>()?)
+            {
+                assert!(
+                    (a.is_nan() && b.is_nan()) || a.to_bits() == b.to_bits(),
+                    "{a:?} != {b:?} for output length {length}"
+                );
+            }
+        }
+        Ok(())
+    })
+}
