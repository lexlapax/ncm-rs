+#[allow(unsafe_code)]
+pub fn linear1d(x: &Array, length: usize) -> Result<Array> {
+    use mlx_rs::fast::{
+        MetalKernel, MetalKernelApplyOptions, MetalKernelOptions, MetalKernelOutput,
+    };
+    let (length, source) = lengths(x, length)?;
+    let &[batch, _, channels] = x.shape() else {
+        return Err("expected BLC".into());
+    };
+    // Preserve the pre-existing general path for types and empty shapes outside
+    // this experimental float32 kernel's contract.
+    if x.dtype() != mlx_rs::Dtype::Float32 || batch <= 0 || channels <= 0 {
+        return linear1d_gather(x, length);
+    }
+    if batch
+        .checked_mul(source)
+        .and_then(|n| n.checked_mul(channels))
+        .is_none()
+    {
+        return linear1d_gather(x, length);
+    }
+    let length_i32 = i32::try_from(length)?;
+    let Some(count) = batch
+        .checked_mul(length_i32)
+        .and_then(|n| n.checked_mul(channels))
+    else {
+        return linear1d_gather(x, length);
+    };
+    let mut low = Vec::with_capacity(length);
+    let mut high = Vec::with_capacity(length);
+    let mut left = Vec::with_capacity(length);
+    let mut right = Vec::with_capacity(length);
+    for i in 0..length {
+        let position = ((i as f64 + 0.5) * f64::from(source) / length as f64 - 0.5).max(0.);
+        let lo = (position.floor() as i32).min(source - 1);
+        let weight = position - lo as f64;
+        low.push(lo);
+        high.push((lo + 1).min(source - 1));
+        left.push((1. - weight) as f32);
+        right.push(weight as f32);
+    }
+    let low = Array::from_slice(&low, &[length_i32]);
+    let high = Array::from_slice(&high, &[length_i32]);
+    let left = Array::from_slice(&left, &[length_i32]);
+    let right = Array::from_slice(&right, &[length_i32]);
+    let kernel = MetalKernel::new(
+        "ncm_linear_fused_codec_v1",
+        &["x", "low", "high", "left", "right"],
+        &["out"],
+        r#"int i = int(thread_position_in_grid.x);
+           int c = x_shape[2]; int n = low_shape[0]; int s = x_shape[1];
+           int channel = i % c; int pos = (i / c) % n; int batch = i / (c * n);
+           float a = x[(batch * s + low[pos]) * c + channel] * left[pos];
+           float b = x[(batch * s + high[pos]) * c + channel] * right[pos];
+           out[i] = a + b;"#,
+        MetalKernelOptions {
+            header: "#pragma clang fp contract(off)\n".into(),
+            ensure_row_contiguous: true,
+            atomic_outputs: false,
+        },
+    )?;
+    // SAFETY: dimensions and grid product are checked, indices are in [0, source),
+    // the kernel receives contiguous inputs and writes each output element once.
+    let mut outputs = unsafe {
+        kernel.apply(
+            &[x, &low, &high, &left, &right],
+            &[MetalKernelOutput {
+                shape: vec![batch, length_i32, channels],
+                dtype: mlx_rs::Dtype::Float32,
+            }],
+            (count, 1, 1),
+            (256, 1, 1),
+            MetalKernelApplyOptions::default(),
+        )?
+    };
+    Ok(outputs.remove(0))
+}
